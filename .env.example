# Solver (OpenAI-compatible). Default DeepSeek resmi; Venice juga bisa lewat DEEPSEEK_BASE_URL.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
# auto | on | off
DEEPSEEK_THINKING=auto
# low | high | max
DEEPSEEK_REASONING_EFFORT=low
DEEPSEEK_TEMPERATURE=0.2

# Browser / sesi
WAYBOT_PROFILE=
WAYBOT_VISION=1
WAYBOT_OCR=auto
WAYBOT_JEDA_MIN=2.5
WAYBOT_JEDA_MAKS=8.0
# WAYBOT_DATA_DIR=
